{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-bookings;Port=5432;Database=bookingsDb;Username=postgres;Password=postgres"
  },

  "JaegerOptions": {
    "OtlpExporterOptions": {
      "EndPoint": "http://jeager:4317",
      "Protocol": "Grpc"
    },
    "BatchExportOptions": {
      "ScheduledDelayMilliseconds": 2000,
      "ExporterTimeoutMilliseconds": 3000
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    }
  },

  "JwtOptions": {
    "SecretKey": "00000000-0000-0000-0000-000000000000",
    "ExpiredMinutes": "15",
    "Audiences": {
      "Bookings": "http://localhost:7179",
      "Events": "http://localhost:5243"
    },
    "Issuer": "http://localhost:5295"
  }
}
