{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5440;Database=usersDb;Username=postgres;Password=postgres"
  },

  "JaegerOptions": {
    "OtlpExporterOptions": {
      "EndPoint": "http://localhost:4317",
      "Protocol": "Grpc"
    },
    "BatchExportOptions": {
      "ScheduledDelayMilliseconds": 2000,
      "ExporterTimeoutMilliseconds": 3000
    }
  },
  
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    }
  },

  "JwtOptions": {
    "SecretKey": "00000000-0000-0000-0000-000000000000",
    "ExpiredMinutes": "15",
    "Audiences": {
      "Bookings": "https://localhost:7178",
      "Events": "https://localhost:7183"
    },
    "Issuer": "https://localhost:7066"
  }
}
