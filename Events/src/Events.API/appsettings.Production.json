{
  "JaegerOptions": {
    "OtlpExporterOptions": {
      "EndPoint": "http://jaeger:4317",
      "Protocol": "Grpc"
    },
    "BatchExportOptions": {
      "ScheduledDelayMilliseconds": 2000,
      "ExporterTimeoutMilliseconds": 3000
    }
  },
  "KafkaOptions": {
    "BootstrapServers": "kafka:9092"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-events;Port=5432;Database=eventsDb;Username=postgres;Password=postgres;"
  },

  "RedisOptions": {
    "ConnectTimeout": "5000",
    "SyncTimeout": "3000",
    "AbortOnConnectFail": "false",
    "EndPoint": "redis:6379"
  },

  "JwtOptions": {
    "SecretKey": "00000000-0000-0000-0000-000000000000",
    "ExpiredMinutes": "15",
    "Audiences": {
      "Bookings": "http://localhost:7179",
      "Events": "http://localhost:5243"
    },
    "Issuer": "http://localhost:5295"
  }
}