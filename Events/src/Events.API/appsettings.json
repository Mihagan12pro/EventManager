{
  "AllowedHosts": "*",

  "CacheKeysOptions": {
    "TopEventsKey": {
      "Key": "events:top:{0}",
      "TTL": 300
    },
    "GetEventKey": {
      "Key": "events:event:{0}",
      "TTL": 300
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    }
  }
}
