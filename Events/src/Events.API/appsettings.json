{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5441;Database=eventsDb;Username=postgres;Password=postgres"
  },

  "AllowedHosts": "*",

  "RedisOptions": {
    "ConnectTimeout": "5000",
    "SyncTimeout": "3000",
    "AbortOnConnectFail": "false",
    "EndPoint": "localhost:6379"
  },

  "CacheKeysOptions": {
    "TopEventsKey": {
      "Key": "events:top:{0}",
      "TTL": 300
    },
    "GetEventKey": {
      "Key": "events:event:{0}",
      "TTL": 300
    }
  }
}
