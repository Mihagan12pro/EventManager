{
  "KafkaOptions": {
    "BootstrapServers": "127.0.0.1:9092"
  },
  "JeagerOptions": {
    "OtlpExporterOptions": {
      "EndPoint": "http://localhost:4317",
      "Protocol": "Grpc"
    },
    "BatchExportOptions": {
      "ScheduledDelayMilliseconds": 2000,
      "ExporterTimeoutMilliseconds": 3000
    }
  },
  "JwtOptions": {
    "SecretKey": "00000000-0000-0000-0000-000000000000",
    "ExpiredMinutes": "15",
    "Audiences": {
      "Bookings": "https://localhost:7178",
      "Events": "https://localhost:7183"
    },
    "Issuer": "https://localhost:7066"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5441;Database=eventsDb;Username=postgres;Password=postgres;"
  },

  "AllowedHosts": "*",

  "RedisOptions": {
    "ConnectTimeout": "5000",
    "SyncTimeout": "3000",
    "AbortOnConnectFail": "false",
    "EndPoint": "localhost:6379"
  },

  "CacheKeysOptions": {
    "TopEventsKey": {
      "Key": "events:top:{0}",
      "TTL": 300
    },
    "GetEventKey": {
      "Key": "events:event:{0}",
      "TTL": 300
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    }
  }
}
