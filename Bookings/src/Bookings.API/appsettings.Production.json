{
  "KafkaOptions": {
    "BootstrapServers": "kafka:9092"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-bookings;Port=5432;Database=bookingsDb;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    }
  },

  "JwtOptions": {
    "SecretKey": "00000000-0000-0000-0000-000000000000",
    "ExpiredMinutes": "15",
    "Audiences": {
      "Bookings": "http://localhost:7179",
      "Events": "http://localhost:5243"
    },
    "Issuer": "http://localhost:5295"
  }
}
